FROM ultralytics/ultralytics:8.4.34

ENV DEBIAN_FRONTEND=noninteractive \
    PIP_NO_CACHE_DIR=1 \
    PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1

ARG APP_UID=1030
ARG APP_GID=1030

WORKDIR /app

# Large (~3.3GB) and effectively static: copied first, before any
# source/dependency layer, so routine code edits never invalidate --
# and force re-pushing -- this layer. Docker's layer cache is
# sequential: once one layer's cache breaks, every layer after it does
# too, so anything that changes often has to stay below this one.
# Numeric --chown avoids depending on the cowbook user/group, which
# doesn't exist yet at this point in the build.
COPY --chown=${APP_UID}:${APP_GID} models/sam3.pt /app/models/sam3.pt

COPY pyproject.toml readme.md /app/

# CLIP/timm are network-installed and don't touch cowbook's own source at
# all -- their own layer, ahead of copying src/, so a source-only change
# never forces re-downloading/rebuilding them either.
RUN python -m pip install --upgrade pip && \
    python -m pip install git+https://github.com/ultralytics/CLIP.git && \
    python -m pip install timm

COPY src /app/src

RUN python -m pip install -e . && \
    groupadd --gid "${APP_GID}" cowbook && \
    useradd --uid "${APP_UID}" --gid "${APP_GID}" --create-home --shell /bin/bash cowbook && \
    mkdir -p /app/var /scratch/vet /home/cowbook/.cache /home/cowbook/.config/Ultralytics && \
    chown -R cowbook:cowbook /app/var /scratch/vet /home/cowbook

COPY --chown=cowbook:cowbook tools /app/tools
COPY --chown=cowbook:cowbook assets /app/assets

ENV HOME=/home/cowbook \
    XDG_CACHE_HOME=/home/cowbook/.cache \
    YOLO_CONFIG_DIR=/home/cowbook/.config/Ultralytics \
    TORCHINDUCTOR_CACHE_DIR=/home/cowbook/.cache/torchinductor

USER cowbook

ENTRYPOINT ["python", "-m", "tools.run_sam3_multi_gpu"]
CMD ["--input-dir", "/scratch/vet/vanzetti18032026_07_13", "--channels", "Ch1", "Ch4", "Ch6", "Ch8", "--model-path", "models/sam3.pt", "--prompts", "cow", "--render-mode", "none", "--output-root", "/scratch/vet/var/batches/sam3_ch1468", "--log-dir", "/scratch/vet/var/batches/sam3_ch1468/logs", "--plan-path", "/scratch/vet/var/batches/sam3_ch1468/plan.json", "--launch"]
