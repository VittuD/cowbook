FROM ultralytics/ultralytics:8.4.34

ENV DEBIAN_FRONTEND=noninteractive \
    PIP_NO_CACHE_DIR=1 \
    PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1

ARG APP_UID=1030
ARG APP_GID=1030

WORKDIR /app

COPY pyproject.toml readme.md /app/
COPY src /app/src

RUN python -m pip install --upgrade pip && \
    python -m pip install git+https://github.com/ultralytics/CLIP.git && \
    python -m pip install timm && \
    python -m pip install -e . && \
    groupadd --gid "${APP_GID}" cowbook && \
    useradd --uid "${APP_UID}" --gid "${APP_GID}" --create-home --shell /bin/bash cowbook && \
    mkdir -p /app/var /scratch/vet /scratch/vet/.cache /scratch/vet/.config/Ultralytics && \
    chown -R cowbook:cowbook /app/var /scratch/vet /scratch/vet

COPY --chown=cowbook:cowbook models /app/models
COPY --chown=cowbook:cowbook sample_data /app/sample_data
COPY --chown=cowbook:cowbook tools /app/tools

ENV HOME=/scratch/vet \
    XDG_CACHE_HOME=/scratch/vet/.cache \
    YOLO_CONFIG_DIR=/scratch/vet/.config/Ultralytics \
    TORCHINDUCTOR_CACHE_DIR=/scratch/vet/.cache/torchinductor

USER cowbook

ENTRYPOINT ["tail", "-f", "/dev/null"]
